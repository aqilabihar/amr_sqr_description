<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.560 0.0 -0.023" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.130 0.0222"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.130 0.0222"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.123"/>
            <inertia ixx="0.000178" ixy="0.0" ixz="0.0"
                     iyy="0.000007" iyz="0.0"
                     izz="0.000175"/>
        </inertial>
    </link>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
        
        <sensor name="depth_camera" type="rgbd_camera">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>5.0</update_rate>
            <topic>depth_camera</topic>
            <gz_frame_id>camera_link</gz_frame_id>
            
            <camera>
                <horizontal_fov>1.047198</horizontal_fov> <image>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>3.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>
