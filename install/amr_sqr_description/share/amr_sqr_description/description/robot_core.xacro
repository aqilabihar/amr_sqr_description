<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>

    <!--    value size      -->
    <xacro:property name="base_mass" value="84.837"/>
    <xacro:property name="base_width" value="0.670"/>
    <xacro:property name="base_length" value="1.172"/>
    <xacro:property name="base_height" value="0.563"/>
    
    <xacro:property name="monitor_mass" value="16.008"/>
    <xacro:property name="monitor_width" value="0.1"/>
    <xacro:property name="monitor_length" value="0.1"/>
    <xacro:property name="monitor_height" value="0.9"/>
    <xacro:property name="monitor_zoff" value="0.730"/>
    <xacro:property name="monitor_xoff" value="0.204"/>    

    <xacro:property name="wheel_mass" value="3.610"/>
    <xacro:property name="wheel_radius" value="0.079"/>
    <xacro:property name="wheel_width" value="0.055"/>
    <xacro:property name="wheel_yoff" value="0.300"/>
    <xacro:property name="wheel_zoff" value="0.231"/>

    <xacro:property name="caster_mass" value="1.355"/>
    <xacro:property name="caster_radius" value="0.0625"/>
    <xacro:property name="caster_width" value="0.0520"/>    
    <xacro:property name="caster_xoff" value="0.300"/> 
    <xacro:property name="caster_yoff" value="-0.0289"/>
    <xacro:property name="caster_zoff" value="0.245"/>   

    <!-- colour -->
    <material name="blue"><color rgba="0 0.4 0.5 1"/></material>
    <material name="grey"><color rgba="0.8 0.8 0.8 1"/></material>
    <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="green"><color rgba="0 1 0 1"/></material>
    <material name="red"><color rgba="1 0 0 1"/></material>

    <!-- BASE FOOTPRINT -->
    <link name="base_footprint">
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius+wheel_zoff}" rpy="0 0 0"/>
    </joint>

    <!-- BASE LINK -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height/2}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height/2}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${base_mass}" w="${base_width}" l="${base_length}" h="${base_height}"/>
    </link>

    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>



    <!-- MONITOR JOINT -->
    <joint name="monitor_joint" type="fixed">
        <parent link="base_link"/>
        <child link="monitor_link"/>
        <origin xyz="${monitor_xoff} 0 ${monitor_zoff}" rpy="0 0 0"/>
    </joint>

    <link name="monitor_link">
        <visual>
            <geometry>
                <box size="${monitor_length} ${monitor_width} ${monitor_height}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="${monitor_length} ${monitor_width} ${monitor_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${monitor_mass}" w="${monitor_width}" l="${monitor_length}" h="${monitor_height}"/>
    </link> 

    <gazebo reference="monitor_link">
        <material>Gazebo/Grey</material>
    </gazebo>



    <!-- LEFT WHEEL -->
    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 ${wheel_yoff} ${-wheel_zoff}" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="dark"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <gazebo reference="left_wheel">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- RIGHT WHEEL -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -${wheel_yoff} ${-wheel_zoff}" rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="dark"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <gazebo reference="right_wheel">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- CASTER WHEEL -->
    <xacro:macro name="caster_wheel" params="prefix x_reflect y_reflect">
        <joint name="${prefix}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_link"/>
            <origin xyz="${x_reflect*caster_xoff} ${y_reflect*(base_width/2+caster_yoff)} ${-caster_zoff}" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}_link">
            <visual>
                <geometry><sphere radius="${caster_radius}"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry><sphere radius="${caster_radius}"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="${caster_mass}" r="${caster_radius}" h="${caster_width}"/>       
        </link>
        
        <gazebo reference="${prefix}_link">
            <material>Gazebo/Black</material>
            <mu1>0.01</mu1>
            <mu2>0.01</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:caster_wheel prefix="casterwhl_fl" x_reflect="-1" y_reflect="1" />
    <xacro:caster_wheel prefix="casterwhl_fr" x_reflect="-1" y_reflect="-1" />
    <xacro:caster_wheel prefix="casterwhl_rl" x_reflect="1" y_reflect="1" />
    <xacro:caster_wheel prefix="casterwhl_rr" x_reflect="1" y_reflect="-1" />

</robot>
